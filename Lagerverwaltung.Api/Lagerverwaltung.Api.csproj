<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Same id as the MVC project: both apps read the same User Secrets, so they share the pepper. -->
    <UserSecretsId>8d2a6fbc-fa41-4f7f-8c9e-0e7d32fae732</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controllers - Copy\**" />
    <Compile Remove="Data - Copy\**" />
    <Compile Remove="DTOs - Copy\**" />
    <Content Remove="Controllers - Copy\**" />
    <Content Remove="Data - Copy\**" />
    <Content Remove="DTOs - Copy\**" />
    <EmbeddedResource Remove="Controllers - Copy\**" />
    <EmbeddedResource Remove="Data - Copy\**" />
    <EmbeddedResource Remove="DTOs - Copy\**" />
    <None Remove="Controllers - Copy\**" />
    <None Remove="Data - Copy\**" />
    <None Remove="DTOs - Copy\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="efpt.config.json.user" />
  </ItemGroup>

</Project>
