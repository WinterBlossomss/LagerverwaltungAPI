<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Kept: the REST API reads the pepper from the same User Secrets (shared UserSecretsId). -->
    <UserSecretsId>8d2a6fbc-fa41-4f7f-8c9e-0e7d32fae732</UserSecretsId>
  </PropertyGroup>

  <!--
    Block 2: the web app no longer talks to the database. Every read and write goes through
    the REST API (Lagerverwaltung.Api) with HttpClient, so there are no EF Core / Identity packages here.
  -->

</Project>
