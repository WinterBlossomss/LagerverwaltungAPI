@model KategorieFormViewModel
@{
    ViewData["Title"] = "Kategorie anlegen";
    var zurueck = Url.IsLocalUrl(Model.ReturnUrl) ? Model.ReturnUrl : Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">Stammdaten · Kategorie</div>
        <h1 class="h2 mb-0">Kategorie anlegen</h1>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Create" method="post">
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Anlegen</button>
                <a href="@zurueck" class="btn btn-outline-secondary">Abbrechen</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}