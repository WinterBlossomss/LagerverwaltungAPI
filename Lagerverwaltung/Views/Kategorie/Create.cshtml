@model Lagerverwaltung.Models.Kategorie

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Kategorie</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Hersteller" class="control-label"></label>
                <input asp-for="Hersteller" class="form-control" />
                <span asp-validation-for="Hersteller" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ModelNum" class="control-label"></label>
                <input asp-for="ModelNum" class="form-control" />
                <span asp-validation-for="ModelNum" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Artikels" class="control-label"></label>
                <input asp-for="Artikels" class="form-control" />
                <span asp-validation-for="Artikels" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="HerstellerNavigation" class="control-label"></label>
                <input asp-for="HerstellerNavigation" class="form-control" />
                <span asp-validation-for="HerstellerNavigation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
