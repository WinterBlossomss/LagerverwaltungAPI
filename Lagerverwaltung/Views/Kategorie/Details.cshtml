@model KategorieDetailsViewModel
@{
    var k = Model.Kategorie;
    ViewData["Title"] = k.Name;
}

<div class="page-header">
    <div>
        <div class="page-kicker">Kategorie</div>
        <h1 class="h2 mb-0">@k.Name</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@k.ID" class="btn btn-outline-secondary">Bearbeiten</a>
        <a asp-action="Delete" asp-route-id="@k.ID" class="btn btn-outline-danger">Löschen</a>
    </div>
</div>

<div class="row g-0 stat-row mb-4">
    <div class="col-6 col-lg-3 stat">
        <div class="stat-label">Hersteller</div>
        <div class="stat-value fs-3">
            @if (k.HerstellerNavigation != null)
            {
                <a asp-controller="Hersteller" asp-action="Details" asp-route-id="@k.Hersteller">@k.HerstellerNavigation.Name</a>
            }
            else { <text>—</text> }
        </div>
    </div>
    <div class="col-6 col-lg-3 stat"><div class="stat-label">Modellnummer</div><div class="stat-value fs-3">@(k.ModelNum?.ToString() ?? "—")</div></div>
    <div class="col-6 col-lg-3 stat"><div class="stat-label">Artikel</div><div class="stat-value fs-3">@Model.Artikel.Count</div></div>
</div>

<h2 class="h5 mb-2">Artikel</h2>
@if (!Model.Artikel.Any())
{
    <p class="text-body-secondary border-top pt-3">Noch keine Artikel in dieser Kategorie.</p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Bezeichnung</th><th>Seriennummer</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in Model.Artikel)
            {
                <tr>
                    <td class="fw-semibold">@a.Name</td>
                    <td>@(a.SerienNum?.ToString() ?? "—")</td>
                    <td class="text-end"><a asp-controller="Artikel" asp-action="Details" asp-route-id="@a.ID" class="btn btn-sm btn-outline-secondary">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-link px-0">Zurück zur Liste</a>