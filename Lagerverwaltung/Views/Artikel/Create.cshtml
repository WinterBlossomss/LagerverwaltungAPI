@model Lagerverwaltung.Models.Artikel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Artikel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SerienNum" class="control-label"></label>
                <input asp-for="SerienNum" class="form-control" />
                <span asp-validation-for="SerienNum" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Kategorie" class="control-label"></label>
                <input asp-for="Kategorie" class="form-control" />
                <span asp-validation-for="Kategorie" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="KategorieNavigation" class="control-label"></label>
                <input asp-for="KategorieNavigation" class="form-control" />
                <span asp-validation-for="KategorieNavigation" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RaumArtikels" class="control-label"></label>
                <input asp-for="RaumArtikels" class="form-control" />
                <span asp-validation-for="RaumArtikels" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
