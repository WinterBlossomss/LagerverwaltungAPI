@model ArtikelFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
<input type="hidden" asp-for="ID" />

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" placeholder="z. B. Dell P2422H" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="KategorieId" class="form-label"></label>
    <div class="d-flex gap-2">
        <select asp-for="KategorieId" asp-items="Model.Kategorien" class="form-select">
            <option value="">Kategorie wählen …</option>
        </select>
        <a asp-controller="Kategorie" asp-action="Create" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="btn btn-outline-secondary text-nowrap">+ Kategorie</a>
    </div>
    <span asp-validation-for="KategorieId" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="HerstellerId" class="form-label"></label>
    <div class="d-flex gap-2">
        <select asp-for="HerstellerId" asp-items="Model.Hersteller" class="form-select">
            <option value="">– ohne Hersteller –</option>
        </select>
        <a asp-controller="Hersteller" asp-action="Create" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="btn btn-outline-secondary text-nowrap">+ Hersteller</a>
    </div>
    <span asp-validation-for="HerstellerId" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="SerienNum" class="form-label"></label>
    <input asp-for="SerienNum" class="form-control" placeholder="leer lassen bei Mengenartikeln (z. B. Kabel)" />
    <div class="form-text">Geräte mit Seriennummer werden einzeln verwaltet. Ohne Seriennummer wird nur die Menge gezählt.</div>
    <span asp-validation-for="SerienNum" class="text-danger small"></span>
</div>

@if (Model.IstNeu)
{
    <div class="mb-3">
        <label asp-for="Anfangsbestand" class="form-label"></label>
        <input asp-for="Anfangsbestand" class="form-control" type="number" min="1" />
        <div class="form-text">Bei Geräten mit Seriennummer immer 1.</div>
        <span asp-validation-for="Anfangsbestand" class="text-danger small"></span>
    </div>
}
