@model ArtikelListeViewModel
@{
    ViewData["Title"] = "Artikel";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Stammdaten</div>
        <h1 class="h2 mb-0">Artikel</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Artikel erfassen</a>
</div>

<form method="get" asp-action="Index" class="row g-3 align-items-end mb-3">
    <div class="col-12 col-md-4">
        <label asp-for="Suche" class="form-label small">Suche</label>
        <input asp-for="Suche" class="form-control" placeholder="Bezeichnung oder Seriennummer" />
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="KategorieId" class="form-label small">Kategorie</label>
        <select asp-for="KategorieId" asp-items="Model.Kategorien" class="form-select">
            <option value="">Alle</option>
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="HerstellerId" class="form-label small">Hersteller</label>
        <select asp-for="HerstellerId" asp-items="Model.Hersteller" class="form-select">
            <option value="">Alle</option>
        </select>
    </div>
    <div class="col-12 col-md-2">
        <button type="submit" class="btn btn-secondary w-100">Filtern</button>
    </div>
</form>

@if (!Model.Artikel.Any())
{
    <p class="text-body-secondary border-top pt-3">Keine Artikel gefunden.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Bezeichnung</th>
                    <th>Kategorie</th>
                    <th>Hersteller</th>
                    <th>Seriennummer</th>
                    <th class="text-end">Bestand gesamt</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Artikel)
                {
                    <tr>
                        <td class="fw-semibold">@a.Name</td>
                        <td>@a.KategorieNavigation?.Name</td>
                        <td>@(a.HerstellerNavigation?.Name ?? "—")</td>
                        <td>@(a.SerienNum?.ToString() ?? "—")</td>
                        <td class="text-end">@(Model.Gesamtbestand.TryGetValue(a.ID, out var s) ? s : 0)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@a.ID" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@a.ID" class="btn btn-sm btn-outline-secondary">Bearbeiten</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
