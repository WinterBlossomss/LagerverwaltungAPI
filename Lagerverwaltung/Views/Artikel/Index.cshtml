@model IEnumerable<Lagerverwaltung.Models.Artikel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SerienNum)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Kategorie)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KategorieNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RaumArtikels)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.SerienNum)
            </td>
            <td>
                @Html.DisplayFor(model => item.Kategorie)
            </td>
            <td>
                @Html.DisplayFor(model => item.KategorieNavigation)
            </td>
            <td>
                @Html.DisplayFor(model => item.RaumArtikels)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
