<ul class="navbar-nav ms-auto align-items-center">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="navbar-text me-3">
                @User.Identity.Name (@(User.IsInRole("Administrator") ? "Administrator" : "LehrerIn"))
            </span>
        </li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="nav-link btn btn-link text-dark p-0">Abmelden</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Anmelden</a>
        </li>
    }
</ul>