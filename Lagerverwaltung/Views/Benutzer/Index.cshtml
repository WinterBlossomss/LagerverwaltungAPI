@model BenutzerListeViewModel
@{
    ViewData["Title"] = "Benutzer";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Benutzer</div>
        <h1 class="h2 mb-0">Benutzer</h1>
    </div>
    <a asp-action="Create" class="btn btn-primary">Neuen Benutzer erfassen</a>
</div>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-12 col-md-6">
        <label asp-for="Suche" class="form-label small">Suche</label>
        <input asp-for="Suche" class="form-control" placeholder="Benutzer suchen..." />
    </div>
    <div class="col-8 col-md-4">
        <label asp-for="Rolle" class="form-label small">Rolle</label>
        <select asp-for="Rolle" asp-items="Model.Rollen" class="form-control">
            <option value="">Alle Rollen</option>
        </select>
    </div>
    <div class="col-8 col-md-4">
        <label asp-for="Labor" class="form-label small">Labor</label>
        <select asp-for="Labor" asp-items="Model.Labore" class="form-control">
            <option value="">Alle Labore</option>
        </select>
    </div>
    <div class="col-4 col-md-2">
        <button type="submit" class="btn btn-secondary w-100">Filtern</button> 
    </div>
</form>

@if(!Model.Benutzer.Any())
{
    <p class="text-body-secondary border-top pt-3">Keine Benutzer gefunden.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Rolle</th>
                    <th>Labor</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Benutzer)
                {
                    <tr>
                        <td class="fw-semibold">@b.Username</td>
                        <td>@b.RolleNavigation?.Name</td>
                        <td>@(b.Raums.Any(r => r.RaumNum != null)
                                ? string.Join(", ", b.Raums.Where(r => r.RaumNum != null).OrderBy(r => r.RaumNum).Select(r => "Raum " + r.RaumNum))
                                : "—")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@b.ID" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@b.ID" class="btn btn-sm btn-outline-secondary">Bearbeiten</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}