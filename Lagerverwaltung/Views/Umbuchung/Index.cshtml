@model UmbuchungViewModel
@{
    ViewData["Title"] = "Umbuchungslager";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Zwischenlager für Rückgaben</div>
        <h1 class="h2 mb-0">Umbuchungslager</h1>
    </div>
</div>

<div class="row g-0 stat-row mb-4">
    <div class="col-4 stat"><div class="stat-label">1 · Zurückgegeben</div><div class="stat-value text-danger">@Model.OffeneRueckgaben.Count</div></div>
    <div class="col-4 stat"><div class="stat-label">2 · Entgegengenommen</div><div class="stat-value">@Model.Bestand.Sum(b => b.Einbuchbar)</div></div>
    <div class="col-4 stat"><div class="stat-label">3 · Zuletzt eingebucht</div><div class="stat-value">@Model.Eingebucht.Count</div></div>
</div>

<h2 class="h5 mb-2">1 · Offene Rückgaben</h2>
@if (!Model.OffeneRueckgaben.Any())
{
    <p class="text-body-secondary border-top pt-3 mb-5">Keine offenen Rückgaben.</p>
}
else
{
    <div class="table-responsive mb-5">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Datum</th>
                    <th>Gegenstand</th>
                    <th class="text-end">Menge</th>
                    <th>Aus</th>
                    <th>Zurückgegeben von</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.OffeneRueckgaben)
                {
                    <tr>
                        <td>@b.Datum.ToString("dd.MM.yyyy")</td>
                        <td>
                            <div class="fw-semibold">@b.ArtikelNavigation.Name</div>
                            <div class="small text-body-secondary">@(b.ArtikelNavigation.SerienNum != null ? "SN " + b.ArtikelNavigation.SerienNum : "ohne Seriennummer")</div>
                        </td>
                        <td class="text-end">@(b.ArtikelMenge ?? 1)</td>
                        <td>@b.VonRaumNavigation.Anzeigename</td>
                        <td>@b.BenutzerNavigation.Username</td>
                        <td class="text-end">
                            <form asp-action="Entgegennehmen" asp-route-id="@b.ID" method="post">
                                <button type="submit" class="btn btn-outline-primary btn-sm">Entgegennehmen</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h5 mb-2">2 · Bestand im Umbuchungslager</h2>
@if (!Model.Bestand.Any())
{
    <p class="text-body-secondary border-top pt-3 mb-5">Das Umbuchungslager ist leer.</p>
}
else
{
    <div class="table-responsive mb-5">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Gegenstand</th>
                    <th>Seriennummer</th>
                    <th class="text-end">Im Lager</th>
                    <th class="text-end">Einbuchbar</th>
                    <th style="width:16rem"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Bestand)
                {
                    <tr>
                        <td class="fw-semibold">@b.Name</td>
                        <td>@(b.SerienNum?.ToString() ?? "—")</td>
                        <td class="text-end">@b.Menge</td>
                        <td class="text-end">@b.Einbuchbar</td>
                        <td>
                            @if (b.Einbuchbar > 0)
                            {
                                <form asp-action="Einbuchen" method="post" class="d-flex gap-2 justify-content-end">
                                    <input type="hidden" name="artikelId" value="@b.ArtikelId" />
                                    @if (b.SerienNum == null)
                                    {
                                        <input type="number" name="menge" value="@b.Einbuchbar" min="1" max="@b.Einbuchbar" class="form-control form-control-sm" style="width:5rem" />
                                    }
                                    else
                                    {
                                        <input type="hidden" name="menge" value="1" />
                                    }
                                    <button type="submit" class="btn btn-primary btn-sm text-nowrap">Ins Hauptlager buchen</button>
                                </form>
                            }
                            else
                            {
                                <span class="small text-body-secondary d-block text-end">Rückgabe erst entgegennehmen</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h5 mb-2">3 · Zuletzt ins Hauptlager gebucht</h2>
<partial name="_BewegungTabelle" model="Model.Eingebucht" />
