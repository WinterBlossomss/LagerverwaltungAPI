@model BewegungenViewModel
@{
    ViewData["Title"] = "Lagerbewegungen";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Historie · abgeschlossene Bewegungen bleiben erhalten</div>
        <h1 class="h2 mb-0">Lagerbewegungen</h1>
    </div>
</div>

<form method="get" asp-action="Index" class="row g-3 align-items-end mb-3">
    <div class="col-12 col-lg-4">
        <label asp-for="Suche" class="form-label small">Suche</label>
        <input asp-for="Suche" class="form-control" placeholder="Gegenstand, Seriennummer oder Benutzer" />
    </div>
    <div class="col-6 col-lg-2">
        <label asp-for="Art" class="form-label small">Art</label>
        <select asp-for="Art" asp-items="Model.Arten" class="form-select">
            <option value="">Alle</option>
        </select>
    </div>
    <div class="col-6 col-lg-2">
        <label asp-for="Status" class="form-label small">Status</label>
        <select asp-for="Status" class="form-select">
            <option value="">Alle</option>
            <option value="offen">Offen</option>
            <option value="abgeschlossen">Abgeschlossen</option>
        </select>
    </div>
    <div class="col-6 col-lg-2">
        <label asp-for="RaumId" class="form-label small">Lager / Labor</label>
        <select asp-for="RaumId" asp-items="Model.Raeume" class="form-select">
            <option value="">Alle</option>
        </select>
    </div>
    <div class="col-6 col-lg-2 d-flex gap-2">
        <button type="submit" class="btn btn-secondary">Filtern</button>
        <a asp-action="Index" class="btn btn-link">Zurücksetzen</a>
    </div>
</form>

<partial name="_BewegungTabelle" model="Model.Bewegungen" />
