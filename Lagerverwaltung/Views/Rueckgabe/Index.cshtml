@model RueckgabeViewModel
@{
    ViewData["Title"] = "Rückgabe";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Rückgabe ins Umbuchungslager</div>
        <h1 class="h2 mb-0">Gegenstände zurückgeben</h1>
    </div>
    @if (Model.Labore.Count > 1)
    {
        <div class="btn-group" role="group" aria-label="Labor wählen">
            @foreach (var l in Model.Labore)
            {
                <a asp-action="Index" asp-route-raumId="@l.ID" class="btn @(l.ID == Model.RaumId ? "btn-dark" : "btn-outline-secondary")">@l.Anzeigename</a>
            }
        </div>
    }
</div>

@if (!Model.Labore.Any())
{
    <p class="text-body-secondary">Ihnen ist noch kein Labor zugeordnet.</p>
    return;
}

<form asp-action="Index" method="post">
    <input type="hidden" asp-for="RaumId" />
    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="row g-4">
        <div class="col-lg-8">
            @if (!Model.Positionen.Any())
            {
                <p class="text-body-secondary border-top pt-3">Im Inventar von @Model.RaumName befinden sich keine Gegenstände.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th style="width:2.5rem"></th>
                                <th>Bezeichnung</th>
                                <th>Seriennummer</th>
                                <th class="text-end">Im Labor</th>
                                <th style="width:8rem">Rückgabe</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Positionen.Count; i++)
                            {
                                var p = Model.Positionen[i];
                                <tr>
                                    <td>
                                        <input type="hidden" asp-for="Positionen[i].ArtikelId" />
                                        <input class="form-check-input" type="checkbox" asp-for="Positionen[i].Ausgewaehlt" id="pos-@i" />
                                    </td>
                                    <td>
                                        <label for="pos-@i" class="fw-semibold">@p.Name</label>
                                        <div class="small text-body-secondary">@p.Kategorie</div>
                                    </td>
                                    <td>@(p.SerienNum?.ToString() ?? "ohne")</td>
                                    <td class="text-end">@p.Verfuegbar</td>
                                    <td>
                                        @if (p.SerienNum == null)
                                        {
                                            <input class="form-control form-control-sm" type="number" min="1" max="@p.Verfuegbar" asp-for="Positionen[i].Menge" />
                                        }
                                        else
                                        {
                                            <input type="hidden" asp-for="Positionen[i].Menge" />
                                            <span class="small text-body-secondary">1</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="summary-panel">
                <h2 class="h5">Rückgabe</h2>
                <div class="d-flex justify-content-between small fw-semibold border-top border-bottom py-2 my-3">
                    <span>@Model.RaumName</span>
                    <span>→</span>
                    <span class="text-danger">Umbuchungslager</span>
                </div>
                <p class="small text-body-secondary">
                    Die Gegenstände werden ins Umbuchungslager gebucht. Der Administrator nimmt sie entgegen
                    und bucht sie anschließend ins Hauptlager.
                </p>
                <button type="submit" class="btn btn-primary w-100">Rückgabe durchführen</button>
            </div>
        </div>
    </div>
</form>
<h2 class="h5 mt-5 mb-2">Offene Rückgaben</h2>
@if (!Model.OffeneRueckgaben.Any())
{
    <p class="text-body-secondary border-top pt-3">Keine offenen Rückgaben für @Model.RaumName.</p>
}
else
{
    <p class="small text-body-secondary">Noch nicht vom Administrator entgegengenommen. Bis dahin kann die Rückgabe storniert werden.</p>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th>Datum</th><th>Bezeichnung</th><th>Seriennummer</th><th class="text-end">Menge</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var b in Model.OffeneRueckgaben)
                {
                    <tr>
                        <td>@b.Datum.ToString("dd.MM.yyyy")</td>
                        <td class="fw-semibold">@b.ArtikelNavigation.Name</td>
                        <td>@(b.ArtikelNavigation.SerienNum?.ToString() ?? "ohne")</td>
                        <td class="text-end">@(b.ArtikelMenge ?? 1)</td>
                        <td class="text-end">
                            <form asp-action="Stornieren" method="post" class="d-inline"
                                  onsubmit="return confirm('Rückgabe von @b.ArtikelNavigation.Name stornieren?');">
                                <input type="hidden" name="id" value="@b.ID" />
                                <input type="hidden" name="raumId" value="@Model.RaumId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Stornieren</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}