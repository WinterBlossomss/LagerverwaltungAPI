@model HerstellerDetailsViewModel
@{
    ViewData["Title"] = Model.Hersteller.Name;
}

<div class="page-header">
    <div>
        <div class="page-kicker">Hersteller</div>
        <h1 class="h2 mb-0">@Model.Hersteller.Name</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Hersteller.ID" class="btn btn-outline-secondary">Bearbeiten</a>
        <a asp-action="Delete" asp-route-id="@Model.Hersteller.ID" class="btn btn-outline-danger">Löschen</a>
    </div>
</div>

<div class="row g-0 stat-row mb-4">
    <div class="col-6 col-lg-3 stat"><div class="stat-label">Kategorien</div><div class="stat-value">@Model.Kategorien.Count</div></div>
    <div class="col-6 col-lg-3 stat"><div class="stat-label">Artikel</div><div class="stat-value">@Model.AnzahlArtikel</div></div>
</div>

<h2 class="h5 mb-2">Kategorien</h2>
@if (!Model.Kategorien.Any())
{
    <p class="text-body-secondary border-top pt-3">Noch keine Kategorie mit diesem Hersteller.</p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Kategorie</th><th>Modellnummer</th><th class="text-end">Artikel</th></tr></thead>
        <tbody>
            @foreach (var k in Model.Kategorien)
            {
                <tr>
                    <td class="fw-semibold">@k.Name</td>
                    <td>@(k.ModelNum?.ToString() ?? "—")</td>
                    <td class="text-end">@k.Artikels.Count</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-link px-0">Zurück zur Liste</a>
