@model RaumFormViewModel
@{
    ViewData["Title"] = "Raum bearbeiten";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Stammdaten · Räume</div>
        <h1 class="h2 mb-0">Raum @Model.RaumNum bearbeiten</h1>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Edit" asp-route-id="@Model.ID" method="post">
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Speichern</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Abbrechen</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
