@using Lagerverwaltung.ViewModels
@model LoginViewModel

@{
    ViewData["Title"] = "Anmelden";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-body-tertiary p-3">
    <div class="card border-0 shadow-sm rounded-4 w-100" style="max-width: 400px;">
        <div class="card-body p-4 p-md-5">

            <h1 class="h3 fw-bold mb-1">Lagerverwaltung</h1>
            <p class="text-body-secondary mb-4">Bitte melden Sie sich an.</p>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Username" class="form-control" placeholder="Benutzername" autocomplete="username" autofocus />
                    <label asp-for="Username"></label>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-2">
                    <input asp-for="Password" class="form-control" placeholder="Passwort" autocomplete="current-password" />
                    <label asp-for="Password"></label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small"></label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">Anmelden</button>
            </form>

            <hr class="my-4" />

            <p class="small text-body-secondary mb-0">
                Kein Zugang oder Passwort vergessen? Benutzer werden vom Administrator angelegt.
            </p>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}
